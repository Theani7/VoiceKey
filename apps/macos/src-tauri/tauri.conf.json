{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "VoiceKey",
  "version": "0.1.0",
  "identifier": "com.voicekey.mac",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VoiceKey",
        "width": 920,
        "height": 620,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "VoiceKey Dictation",
        "url": "overlay.html",
        "width": 320,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
